{
  "name": "agent-pay",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/api",
    "apps/agent"
  ],
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "demo": "node scripts/demo.mjs",
    "demo:record": "node scripts/record-demo.mjs",
    "demo:submission": "node scripts/record-submission.mjs",
    "demo:seed-needs-check": "node apps/web/scripts/seed-needs-check.mjs",
    "test": "npm test --workspaces --if-present && cd apps/web && pnpm test",
    "typecheck": "npm run typecheck --workspaces --if-present && cd apps/web && pnpm typecheck",
    "web:install": "cd apps/web && pnpm install --frozen-lockfile",
    "agent": "npm run -s agent -w @agent-pay/agent --",
    "api": "node --env-file-if-exists=.env apps/api/src/main.ts",
    "secret-scan": "bash scripts/secret-scan.sh"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  }
}
