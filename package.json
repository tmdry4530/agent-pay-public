{
  "name": "agent-pay",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/api",
    "apps/agent"
  ],
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "demo": "node scripts/demo.mjs",
    "demo:record": "node scripts/record-demo.mjs",
    "demo:submission": "node scripts/record-submission.mjs",
    "test": "npm test --workspaces --if-present && pnpm -C apps/web test",
    "typecheck": "npm run typecheck --workspaces --if-present && pnpm -C apps/web typecheck",
    "web:install": "pnpm -C apps/web install --frozen-lockfile"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  }
}
