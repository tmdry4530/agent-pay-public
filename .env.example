# agent-pay API environment. Names only: copy to .env (gitignored), fill in locally, never commit values.
# Load it with: npm run api (reads .env only if it exists), or node --env-file=.env apps/api/src/main.ts.
# npm run demo also passes .env to the API when it exists; the demo's rail comes from the shell RAIL (default mock).
# Empty values fall back to the defaults below.

# Port to listen on (default 8787; 0 = random free port)
PORT=
# Bind address (default 127.0.0.1)
HOST=
# Ledger JSON file (default apps/api/.data/ledger.json); one writer process per file
LEDGER_PATH=
# Payment rail: mock | paypal (PayPal Payouts v1 sandbox) | near (NEAR testnet native transfer); default mock
RAIL=
# Optional for RAIL=paypal or near: name=address pairs, comma-separated, replacing the default payee map
DEMO_PAYEES=
# Optional live-demo knob: lower the approval threshold (rail currency; default 50 USD / 0.5 NEAR), e.g. 5 so
# the 10 USD "small" scenario stops for human approval. Must be >= 0 and below perTxMax.
DEMO_APPROVAL_ABOVE=
# Background re-check of pending receipts (ms between checks; default 5000, 0 = off) and how long to keep
# checking one intent (default 600000 = 10 minutes)
RECEIPT_POLL_MS=
RECEIPT_POLL_TIMEOUT_MS=

# PayPal Payouts sandbox, required when RAIL=paypal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional, default https://api-m.sandbox.paypal.com
PAYPAL_BASE_URL=
# Integration tests only (packages/adapters): sandbox payout receiver email
PAYPAL_PAYOUT_RECEIVER=

# NEAR, required when RAIL=near
NEAR_ACCOUNT_ID=
NEAR_PRIVATE_KEY=
# Optional: testnet (default) | mainnet
NEAR_NETWORK=
# Optional, default https://test.rpc.fastnear.com (FASTNEAR public testnet endpoint, listed on
# https://docs.near.org/api/rpc/providers), or https://rpc.mainnet.near.org for mainnet
NEAR_RPC_URL=
# Integration tests only (packages/adapters): NEAR receiver account
NEAR_RECEIVER_ID=

# Agent CLI LLM planner (npm run agent -- --planner llm). Read from the shell env by the agent, not the API.
# OPENAI_API_KEY wins if set; else OPENROUTER_API_KEY; with neither the agent uses the rule-based planner.
# Never commit a real key.
OPENAI_API_KEY=
# Optional OpenAI model id, default gpt-4o-mini
OPENAI_MODEL=
OPENROUTER_API_KEY=
# Optional OpenRouter model id, default openai/gpt-4o-mini
OPENROUTER_MODEL=
