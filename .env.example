# agent-pay API environment. Names only: copy to .env (gitignored), fill in locally, never commit values.
# Load it with: node --env-file=.env apps/api/src/main.ts
# Empty values fall back to the defaults below.

# Port to listen on (default 8787; 0 = random free port)
PORT=
# Bind address (default 127.0.0.1)
HOST=
# Ledger JSON file (default apps/api/.data/ledger.json); one writer process per file
LEDGER_PATH=
# Payment rail: mock | paypal | near (default mock; near is not wired yet and exits at startup)
RAIL=

# PayPal sandbox, required when RAIL=paypal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional, default https://api-m.sandbox.paypal.com
PAYPAL_BASE_URL=

# NEAR: no env vars are read yet (RAIL=near is not wired in this build).
